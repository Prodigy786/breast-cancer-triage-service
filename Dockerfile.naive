FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and pip using system package manager
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-wheel \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy entire project directory
COPY . /workspace

# Install dependencies inside the image
RUN pip3 install --no-cache-dir -r requirements-train.txt -r requirements-serve.txt

# Train model inside image
RUN python3 training/train.py --data-path data/raw/breast_cancer.csv --output-dir artifacts --model-version 1.0.0

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
